# ─── NinjaPing backend environment ───────────────────────────────────────
# Everything is optional. With ZERO keys the app runs fully live against
# CoinGecko + the public Injective LCD and uses the local report templater.
# Add keys to progressively unlock richer features.

# ── LLM (Pulse synthesis) — provider auto-selects anthropic > openai > local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Supabase (optional durable mirror + Realtime for the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Injective on-chain (public endpoints — no key needed)
INJECTIVE_LCD=https://sentry.lcd.injective.network
INJECTIVE_INDEXER=https://sentry.exchange.grpc-web.injective.network
# CW721 collection address for the N1NJ4 holder gate (leave blank to disable gate)
NINJA_NFT_CONTRACT=

# ── Market data (CoinGecko public API — key only needed for Pro tier)
COINGECKO_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# ── Social (optional): free CryptoPanic key → real per-token news/social posts.
# Without it, social uses live CoinGecko search-trending + turnover (still real).
CRYPTOPANIC_KEY=
CRYPTOPANIC_BASE=https://cryptopanic.com/api/v1

# ── Frontend origin used to build shareable Raid-on-X permalinks
FRONTEND_URL=http://localhost:3000

# ── Anomaly engine tuning
SCAN_INTERVAL_SECONDS=25
VOL_VELOCITY_THRESHOLD=1.5
WHALE_USD_FLOOR=20000
SOCIAL_VELOCITY_THRESHOLD=100
DEMO_HEARTBEAT_SCANS=2
# A call is graded HIT/MISS vs live price once it is this old (lower = snappier demo)
GRADE_AFTER_SECONDS=60

# ── Server
CORS_ORIGINS=http://localhost:3000
MAX_FEED_SIZE=200
